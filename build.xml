<?xml version="1.0" encoding="UTF-8"?>
<project name="HelloAnt" default="war" basedir=".">

    <!-- Change this if Tomcat is installed elsewhere -->
    <property name="tomcat.home"
              value="C:/Program Files/Apache Software Foundation/Tomcat 10.1"/>

    <property name="src.dir"   value="src"/>
    <property name="web.dir"   value="WebContent"/>
    <property name="build.dir" value="build/classes"/>
    <property name="dist.dir"  value="dist"/>

    <!-- Servlet API is only needed to compile; Tomcat provides it at runtime -->
    <path id="compile.classpath">
        <fileset dir="${tomcat.home}/lib" includes="servlet-api.jar"/>
    </path>

    <target name="clean">
        <delete dir="build"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="compile">
        <mkdir dir="${build.dir}"/>
        <javac srcdir="${src.dir}" destdir="${build.dir}"
               includeantruntime="false" release="17"
               classpathref="compile.classpath"/>
    </target>

    <target name="war" depends="clean,compile">
        <mkdir dir="${dist.dir}"/>
        <war destfile="${dist.dir}/${ant.project.name}.war"
             webxml="${web.dir}/WEB-INF/web.xml">
            <fileset dir="${web.dir}" excludes="WEB-INF/web.xml"/>
            <classes dir="${build.dir}"/>
        </war>
    </target>

</project>
